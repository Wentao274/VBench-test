# ============================================================
# VBench 流水线配置模板
#
# 用法:
#   cp vbench.env.example vbench.env   然后把真实值填进去
#
# 注意:
#   vbench.env 已被 .gitignore 排除，不会提交到仓库
#   （内网地址、鉴权 token 等敏感信息只放在 vbench.env 里）
# ============================================================

# ---------- 必填 ----------

# Video Gateway 地址（不含末尾斜杠）
#   模型与评测同机:        http://localhost:8000
#   模型在其他机器:        http://<IP>/<路由名>
GATEWAY_URL="http://<GATEWAY_URL>"

# 被测模型名（必须出现在网关 GET /v1/models 列表中）
MODEL="minimax-h3"

# 采样输出根目录（每次运行自动创建时间戳子目录，多次测试互不覆盖）
OUTPUT_DIR="./sampled_videos/h3"

# ---------- 可选（留空 = 不启用）----------

# 指定空闲卡号，多卡节点用（留空 = 默认使用 0 号卡）
# GPU_ID="1"
GPU_ID=""

# 同时挂起的生成任务数（留空 = 默认 4；想单并发填 1，注意全量耗时约增至 4 倍）
# CONCURRENCY="1"
CONCURRENCY=""

# 只测部分维度，空格分隔（留空 = 全部 16 个维度）
# DIMENSIONS="subject_consistency motion_smoothness"
DIMENSIONS=""

# 设为 true 时附加 --load_ckpt_from_local（DINO/CLIP 从本地缓存加载，
# 适用于访问 GitHub 受限的内网机器；下载权重时也要同样带上）
# LOAD_LOCAL="true"
LOAD_LOCAL=""

# ---------- 预留 ----------

# 将来 Gateway 增加鉴权时填在这里（当前脚本尚未使用，勿删格式）
# API_TOKEN=""
